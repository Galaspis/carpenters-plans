  "derived": {
    "Dwant": "pavD + beyond",
    "D": "clamp(Dwant, 1200, min(4000, wall_depth))",
    "qRoof": "0.001",
    "sigAdm": "7",
    "Ewood": "9000",
    "rafterSpan": "D - beam_t - overhang - fbeam_t",
    "rPitchMax": "600",
    "nR": "max(2, ceil((W - beam_t) / rPitchMax) + 1)",
    "rPitch": "nR > 1 ? (W - beam_t) / (nR - 1) : 0",
    "wRafter": "qRoof * rPitch",
    "rafterCapB": "sqrt(4 * sigAdm * beam_t * beam_w * beam_w / (3 * wRafter))",
    "rafterCapD": "cbrt(384 * Ewood * (beam_t * beam_w * beam_w * beam_w / 12) / (1000 * wRafter))",
    "rafterCap": "floor(min(rafterCapB, rafterCapD))",
    "overhangMax": "floor(rafterSpan / 4)",
    "nPosts": "posts",
    "sideOver": "min(500, snap((W - post_t) / 7, 10))",
    "postX0": "sideOver",
    "postStep": "nPosts > 1 ? (W - 2*sideOver - post_t) / (nPosts - 1) : 0",
    "beamSpan": "postStep - post_t",
    "wBeam": "qRoof * (rafterSpan / 2 + overhang + fbeam_t)",
    "beamCapB": "sqrt(4 * sigAdm * fbeam_t * fbeam_w * fbeam_w / (3 * wBeam))",
    "beamCapD": "cbrt(384 * Ewood * (fbeam_t * fbeam_w * fbeam_w * fbeam_w / 12) / (1000 * wBeam))",
    "beamCap": "floor(min(beamCapB, beamCapD))",
    "rafterLen": "D - beam_t",
    "pPitchMax": "600",
    "nP": "max(2, floor((rafterLen - overhang - 2*purlin_w) / pPitchMax) + 2)",
    "pPitch": "nP > 1 ? (rafterLen - overhang - purlin_w) / (nP - 1) : 0",
    "beamZ": "H",
    "postH": "H - fbeam_w",
    "sheets": "ceil(W / 1050)",
    "sheetLen": "ceil(rafterLen / 100) * 100 + 100",
    "wallY": "D",
    "nSeg": "12",
    "nAnch": "ceil(W / 600) + 1",
    "aPitch": "(W - 300) / (nAnch - 1)",
    "wallH": "max(wall_height, balcZ + 400) + 300",
    "balcR": "(balcC*balcC/4 + balcS*balcS) / (2*balcS)",
    "balcK": "balcR - balcS",
    "balcX": "balcE - balcC/2",
    "lampCX": "lampOnDoor ? doorX + doorW/2 : lampX",
    "hasLamp": "lampGap > 0 ? 1 : 0",
    "lampTop": "wall_height - lampGap",
    "lampInSpan": "hasLamp && lampCX > wallOff && lampCX < wallOff + W ? 1 : 0",
    "lampNeedH": "lampInSpan ? lampTop + 20 - 125 : 0",
    "lampZ": "lampTop - 200",
    "lampW": "200",
    "lampD": "120"
  },
