        "beam_t",
        "beam_w"
      ]
    },
    {
      "id": "ledger",
      "name": "קורת קיר",
      "profile": "beam",
      "count": 1,
      "at": [
        "0",
        "D - beam_t",
        "beamZ"
      ],
      "size": [
        "W",
        "beam_t",
        "beam_w"
      ]
    },
    {
      "id": "rafter",
      "name": "רפטר (קורת גג)",
      "profile": "beam",
      "count": "nR",
      "at": [
        "i*rPitch",
        "0",
        "beamZ"
      ],
      "size": [
        "beam_t",
        "rafterLen",
        "beam_w"
      ]
    },
    {
      "id": "purlin",
      "name": "מריש",
      "profile": "purlin",
      "count": "nP",
      "at": [
        "0",
        "overhang + i*pPitch",
        "beamZ + beam_w"
      ],
      "size": [
        "W",
        "purlin_w",
        "purlin_t"
      ]
    }
  ],
