      "w": 145
    },
    "purlin": {
      "label": "מרישים לגג",
      "t": 45,
      "w": 70
    },
    "base": {
      "label": "בסיסי עמוד (מתכת)",
      "t": 3,
      "w": 100,
      "hardware": true
    }
  },
  "params": [
    {
      "id": "W",
      "label": "אורך לאורך הקיר",
      "value": 4000,
      "min": 1500,
      "max": 7000,
      "step": 50,
      "fit": true,
      "fitStage": 1,
      "suggest": "snap(min(7000, wall_width - 100), 50)",
