{
  "id": "pergola-leanto",
  "name": "פרגולה צמודה לקיר עם גג פוליקרבונט",
  "description": "פרגולה נשענת על קיר הבית: קורת קיר, שני עמודים קדמיים על בסיסי מתכת, קורה קדמית, קורות גג (רפטרים) בין הקיר לקורה הקדמית, מרישים לרוחב ויריעות פוליקרבונט שקופות. השיפוע לניקוז נוצר בהתקנה — קורת הקיר נקבעת גבוה יותר מהקורה הקדמית.",
  "category": "גינה",
  "units": "mm",
  "view": {
    "azimuth": 30,
    "elevation": 22
  },
  "spaces": [
    {
      "id": "wall",
      "label": "הקיר שעליו נשענת הפרגולה",
      "fields": {
        "width": {
          "label": "אורך הקיר הפנוי (מ\"מ)",
          "value": 4200
        },
        "depth": {
          "label": "עומק פנוי מהקיר החוצה (מ\"מ)",
          "value": 2800
        },
        "height": {
          "label": "גובה מקסימלי בקיר, מתחת לחלון/גג (מ\"מ)",
          "value": 2800
        }
      }
    }
  ],
  "profiles": {
