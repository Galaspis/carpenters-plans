  "derived": {
    "nPosts": "W > 4500 ? 3 : 2",
    "nR": "max(2, round((W - beam_t) / spacing) + 1)",
    "rPitch": "nR > 1 ? (W - beam_t) / (nR - 1) : 0",
    "rafterLen": "D - beam_t",
    "nP": "max(2, floor((rafterLen - overhang - 2*purlin_w) / pspacing) + 2)",
    "pPitch": "nP > 1 ? (rafterLen - overhang - purlin_w) / (nP - 1) : 0",
    "beamZ": "H",
    "postH": "H - beam_w",
    "postX0": "sideOver",
    "postStep": "nPosts > 1 ? (W - 2*sideOver - post_t) / (nPosts - 1) : 0",
    "sheets": "ceil(W / 1050)",
    "sheetLen": "ceil(rafterLen / 100) * 100 + 100",
    "wallY": "D",
    "nSeg": "10"
  },
