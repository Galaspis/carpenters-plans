  "placeView": {
    "azimuth": -35,
    "elevation": 18
  },
  "checks": [
    {
      "when": "lampInSpan && H + 125 < lampTop + 20",
      "text": "קורת הקיר תתנגש במנורה: תחתית הקורה בקיר (עם השיפוע) ב-{H + 125}, והמנורה מגיעה עד {lampTop}. הגובה החופשי צריך להיות לפחות {lampTop + 20 - 125}."
    },
    {
      "when": "H + 125 + beam_w + purlin_t + 16 > wall_height - 20",
      "text": "אין מקום מתחת למרפסת: הגג מעל קורת הקיר מגיע ל-{H + 125 + beam_w + purlin_t + 16} והמרפסת ב-{wall_height}. הנמך את הגובה החופשי, או השתמש בקורות נמוכות יותר."
    },
    {
      "when": "sideD > 0 && wallOff < 50",
      "text": "הפרגולה צמודה לקיר הצד: השאר לפחות 50 מ\"מ בין קצה הקורות לקיר הצד."
    },
    {
      "when": "rafterSpan > rafterCap",
      "text": "הרפטרים חלשים מדי: המפתח ביניהם {rafterSpan} מ\"מ, וחתך {beam_t}×{beam_w} בטוח עד {rafterCap}. בשלב \"עץ\" בחר לרפטרים חתך גבוה יותר (45×195 או 70×195), או הקטן את העומק."
    },
    {
      "when": "overhang > overhangMax",
      "text": "הבליטה {overhang} גדולה מרבע המפתח ({overhangMax}): הרפטרים ייכפפו בקצה. בחר בליטה קטנה יותר או הגדל את העומק."
    },
    {
      "when": "beamSpan > beamCap",
      "text": "הקורה הקדמית חלשה מדי לשני עמודים: המפתח בין העמודים {beamSpan} מ\"מ, וחתך {fbeam_t}×{fbeam_w} בטוח עד {beamCap}. בחר לקורה הקדמית חתך גדול יותר (70×195), או עבור לשלושה עמודים."
    },
    {
      "when": "rPitch > 620",
      "text": "מרחק הרפטרים {rPitch} גדול מדי ליריעת פוליקרבונט 16 מ\"מ (עד 600)."
    },
    {
      "when": "D < Dwant",
      "text": "העומק הפנוי שהזנת בשלב \"מקום\" ({wall_depth}) קטן מהריצוף ({pavD}) ועוד הבליטה שביקשת ({beyond}) = {Dwant}. \"עומק פנוי\" הוא כמה אפשר לצאת מהקיר, כולל מעבר לריצוף — אם יש שם מקום, הגדל אותו; אחרת בקש בליטה קטנה יותר. בינתיים הגג מגיע ל-{D}."
    }
  ],
  "strength": [
    {
      "label": "רפטרים",
