    },
    {
      "id": "D",
      "label": "עומק (מהקיר החוצה)",
      "value": 2500,
      "min": 1200,
      "max": 4000,
      "step": 50,
      "fit": true,
      "fitStage": 1,
      "suggest": "snap(min(4000, wall_depth - 200), 50)",
      "suggestNote": "העומק הפנוי פחות 200 מ\"מ"
    },
    {
      "id": "H",
      "label": "גובה חופשי מתחת לקורות (בקצה הקדמי)",
      "value": 2300,
      "min": 1900,
      "max": 3000,
      "step": 50,
      "fit": true,
      "fitStage": 1,
      "suggest": "snap(min(3000, wall_height - 125 - beam_w - purlin_t - 60), 50)",
      "suggestNote": "הגובה בקיר פחות השיפוע (125), הקורה, המרישים ומרווח"
    },
    {
      "id": "spacing",
      "label": "מרחק בין רפטרים (מ\"מ)",
      "value": 650,
      "min": 400,
      "max": 900,
      "step": 50
    },
    {
      "id": "pspacing",
      "label": "מרחק בין מרישים (מ\"מ)",
      "value": 600,
      "min": 400,
      "max": 1000,
      "step": 50
    },
    {
      "id": "overhang",
      "label": "בליטת הרפטרים מעבר לקורה הקדמית",
      "value": 200,
      "min": 0,
      "max": 500,
      "step": 10
    },
    {
      "id": "sideOver",
      "label": "בליטת הקורות בצדדים מעבר לעמודים",
      "value": 150,
      "min": 0,
      "max": 400,
      "step": 10
    }
  ],
  "derived": {
    "nPosts": "W > 4500 ? 3 : 2",
    "nR": "max(2, round((W - beam_t) / spacing) + 1)",
    "rPitch": "nR > 1 ? (W - beam_t) / (nR - 1) : 0",
    "rafterLen": "D - beam_t",
    "nP": "max(2, floor((rafterLen - overhang - 2*purlin_w) / pspacing) + 2)",
    "pPitch": "nP > 1 ? (rafterLen - overhang - purlin_w) / (nP - 1) : 0",
    "beamZ": "H",
    "postH": "H - beam_w",
    "postX0": "sideOver",
    "postStep": "nPosts > 1 ? (W - 2*sideOver - post_t) / (nPosts - 1) : 0",
    "sheets": "ceil(W / 1050)",
    "sheetLen": "ceil(rafterLen / 100) * 100 + 100"
  },
  "dims": [
    {
      "label": "גובה חופשי",
      "value": "H",
      "from": [
        "W + 120",
        "overhang",
        "0"
      ],
      "to": [
        "W + 120",
        "overhang",
        "H"
      ]
    },
    {
      "label": "עומק",
      "value": "D",
      "from": [
        "-120",
        "0",
        "0"
      ],
      "to": [
        "-120",
        "D",
        "0"
      ]
    }
  ],
  "parts": [
    {
      "id": "base",
      "name": "בסיס עמוד מתכת",
      "profile": "base",
