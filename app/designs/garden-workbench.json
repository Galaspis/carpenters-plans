  "derived": {
    "frameZ": "H - board_t - rail_w",
    "postH": "H - board_t - wheelH",
    "innerW": "W - 2*rail_t",
    "innerD": "D - 2*rail_t",
    "nTop": "floor((D + gap) / (board_w + gap))",
    "gapTop": "nTop > 1 ? (D - nTop*board_w) / (nTop - 1) : 0",
    "shelfW": "innerW",
    "nShelf": "floor((innerD + gap) / (board_w + gap))",
    "gapShelf": "nShelf > 1 ? (innerD - nShelf*board_w) / (nShelf - 1) : 0",
    "nWall": "wall > 0 ? max(1, floor((wall - 40 + gap) / (board_w + gap))) : 0",
    "wallZ0": "H + wall - nWall*board_w - (nWall-1)*gap",
    "px0": "rail_t",
    "px1": "W - rail_t - post_t",
    "py0": "rail_t",
    "py1": "D - rail_t - post_t",
    "uprightH": "H + wall - frameZ",
    "shelfTop": "max(shelfZ, wheelH + rail_w)"
  },
