  "steps": [
    {
      "title": "חיתוך וקידוח כל החלקים",
      "text": "חתוך כל חלק לאורכו לפי תוכנית החיתוך. קדח את החורים לפי שרטוט החלקים. לטש את כל הפאות (נייר 80 ואז 120).",
      "add": []
    },
    {
      "title": "בניית שתי מסגרות הצד",
      "text": "הנח רגל קדמית ועמוד אחורי על הרצפה. הברג את הקורה הצדדית העליונה ביניהם, בקו אחד עם ראש הרגל הקדמית. חזור על זה לצד השני.",
      "add": [
        "frontLeg",
        "backPost",
        "sideRail"
      ],
      "tip": "השתמש בזווית 90° — מסגרות הצד קובעות אם השולחן יעמוד ישר."
    },
    {
      "title": "חיבור הצדדים בקורות הארוכות",
      "text": "העמד את שתי מסגרות הצד. הברג את שתי הקורות הארוכות העליונות ואת שתי קורות המדף ביניהן. בדוק שהאלכסונים שווים.",
      "add": [
        "longRail",
        "longShelfRail"
      ]
    },
    {
      "title": "הוספת התומכים",
      "text": "התקן את התומך האמצעי של המשטח ואת תומכי המדף בין הקורות הארוכות.",
      "add": [
        "midRail",
        "shelfBearer"
      ]
    },
    {
      "title": "הנחת המדף התחתון",
      "text": "הנח את קרשי המדף על התומכים עם הרווח המסומן, והברג.",
      "add": [
        "shelfBoard"
      ]
    },
    {
      "title": "הרכבת משטח העבודה",
      "text": "הנח את קרשי המשטח, מהקדמי לאחורי. שמור על רווח אחיד בעזרת שבלונה. הברג כל קרש לקורות שמתחתיו.",
      "add": [
        "topBoard"
      ],
      "tip": "שקע (countersink) את החורים כדי שראשי הברגים יישבו מתחת לפני העץ."
    },
    {
      "title": "בניית קיר הכלים",
      "text": "הברג את השלבים לרוחב העמודים האחוריים, מלמטה למעלה, עם רווח אחיד. ברווחים תולים ווים.",
      "add": [
        "backSlat"
      ]
    },
    {
      "title": "המדף העליון",
      "text": "הברג את התומכים לצד הפנימי של העמודים האחוריים, ואז קבע את קרשי המדף מעליהם.",
      "add": [
        "topShelfBracket",
        "topShelfBoard"
      ]
    },
    {
      "title": "גימור",
      "text": "עגל פינות חדות ומרח שתי שכבות שמן לעץ חיצוני. הוסף ווים לרווחי השלבים.",
      "add": []
    }
  ]
