  ],
  "derived": {
    "ovR": "rightSide ? ov : 0",
    "innerW": "W - ov - ovR - 2*post_t",
    "innerD": "D - ov - post_t - post_t",
    "postH": "H - slat_t",
    "frameZ": "postH - rail_w",
    "sideLen": "D - ov",
    "sillBase": "sillSides ? sillZ : 0",
    "nSide": "floor((postH - sillBase - 2*rail_w - 40 + gap) / (slat_w + gap))",
    "sideStart": "sillBase + rail_w + 20",
    "doorW": "doorCount > 0 ? (innerW - (doorCount + 1)*6) / doorCount : 0",
    "doorH": "frameZ - rail_w - 12 - sillZ",
    "doorSlatLen": "doorW",
    "nDoor": "floor((doorH - 20 - hoseGap + gap) / (dslat_w + gap))",
    "doorSlatStart": "doorH - 10 - (nDoor*dslat_w + (nDoor-1)*gap + hoseGap)",
    "nTop": "floor((D + gap) / (slat_w + gap))",
    "gapTop": "nTop > 1 ? (D - nTop*slat_w) / (nTop - 1) : 0",
    "slatZ0": "sillZ + rail_w + 6 + doorSlatStart",
    "hingeZ1": "slatZ0 + (dslat_w + gap) + (dslat_w - 40)/2",
    "hingeZ2": "slatZ0 + (nDoor - 2)*(dslat_w + gap) + hoseGap + (dslat_w - 40)/2",
    "doorX0": "ov + post_t + 6"
  },
  "dims": [],
  "parts": [
    {
      "id": "post",
      "name": "עמוד",
      "profile": "post",
      "count": 4,
      "at": [
        "ov + (i % 2)*(W - ov - ovR - post_t)",
        "ov + floor(i/2)*(D - ov - post_t)",
        "0"
      ],
      "size": [
        "post_t",
        "post_t",
        "postH"
      ]
    },
    {
      "id": "topRailF",
      "name": "קורת גג קדמית/אחורית",
      "profile": "rail",
      "count": 2,
      "at": [
        "ov + post_t",
        "ov + i*(D - ov - post_t) + (post_t - rail_t)/2",
        "frameZ"
      ],
      "size": [
        "innerW",
        "rail_t",
        "rail_w"
      ]
    },
    {
      "id": "topRailS",
      "name": "קורת גג צדדית",
      "profile": "rail",
      "count": 2,
      "at": [
        "ov + i*(W - ov - ovR - post_t) + (post_t - rail_t)/2",
        "ov + post_t",
        "frameZ"
      ],
      "size": [
        "rail_t",
        "innerD",
        "rail_w"
      ]
    },
    {
      "id": "sill",
      "name": "קורה תחתונה",
      "profile": "rail",
      "count": "2*sillSides + 1",
      "at": [
        "sillSides && i < 2 ? ov + i*(W - ov - ovR - post_t) + (post_t - rail_t)/2 : ov + post_t",
        "sillSides && i < 2 ? ov + post_t : ov + (post_t - rail_t)/2",
        "sillSides && i < 2 ? sillZ : sillZ"
      ],
      "size": [
        "sillSides && i < 2 ? rail_t : innerW",
        "sillSides && i < 2 ? innerD : rail_t",
        "rail_w"
      ]
    },
    {
      "id": "sideSlat",
      "name": "שלב צד",
      "profile": "slat",
      "count": "nSide * (1 + rightSide)",
      "at": [
        "rightSide ? ((i % 2) ? W - ovR : ov - slat_t) : ov - slat_t",
        "ov",
        "sideStart + (rightSide ? floor(i/2) : i)*(slat_w + gap)"
      ],
      "size": [
        "slat_t",
        "sideLen",
        "slat_w"
      ]
    },
    {
      "id": "stile",
      "name": "ניצב דלת",
      "profile": "frame",
      "count": "2*doorCount",
      "at": [
        "doorX0 + (i % 2)*(doorW - frame_w) + floor(i/2)*(doorW + 6)",
        "ov + dslat_t",
        "sillZ + rail_w + 6"
      ],
      "size": [
        "frame_w",
        "frame_t",
        "doorH"
      ]
    },
    {
      "id": "doorRail",
      "name": "קורת דלת",
      "profile": "frame",
      "count": "2*doorCount",
      "at": [
        "doorX0 + frame_w + floor(i/2)*(doorW + 6)",
        "ov + dslat_t",
        "sillZ + rail_w + 6 + (i % 2)*(doorH - frame_w)"
      ],
      "size": [
        "doorW - 2*frame_w",
        "frame_t",
        "frame_w"
      ]
    },
    {
      "id": "doorSlat",
      "name": "שלב דלת",
      "profile": "dslat",
      "count": "nDoor*doorCount",
      "at": [
        "doorX0 + (i % max(1, doorCount))*(doorW + 6)",
        "ov",
        "sillZ + rail_w + 6 + doorSlatStart + floor(i/max(1, doorCount))*(dslat_w + gap) + (floor(i/max(1, doorCount)) >= nDoor - 3 ? hoseGap : 0)"
      ],
      "size": [
        "doorW",
        "dslat_t",
        "dslat_w"
      ]
    },
    {
      "id": "topBoard",
      "name": "קרש גג",
      "profile": "slat",
      "count": "nTop",
      "at": [
        "0",
        "i*(slat_w + gapTop)",
        "postH"
      ],
      "size": [
        "W",
        "slat_w",
        "slat_t"
      ]
    },
    {
      "id": "hinge",
      "name": "ציר T",
      "profile": "hinge",
      "count": "2*doorCount",
      "at": [
        "floor(i/2) == 0 ? ov + 20 : W - ovR - 140",
        "ov - 3",
        "i % 2 ? hingeZ2 : hingeZ1"
      ],
      "size": [
        "120",
        "3",
        "40"
      ]
    },
    {
      "id": "benchBackPost",
      "name": "העמוד האחורי של השולחן (קיים)",
      "profile": "post",
      "count": "1 - rightSide",
      "existing": true,
      "at": [
        "W",
        "benchD - ov - post_t",
        "0"
      ],
      "size": [
        "post_t",
        "post_t",
        "benchPostH"
      ]
    },
    {
      "id": "benchFrontLeg",
      "name": "הרגל הקדמית של השולחן (קיימת)",
      "profile": "post",
      "count": "1 - rightSide",
      "existing": true,
      "at": [
        "W",
        "ov",
        "0"
      ],
      "size": [
        "post_t",
        "post_t",
        "878"
      ]
    }
  ],
