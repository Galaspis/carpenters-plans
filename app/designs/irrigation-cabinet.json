  "steps": [
    {
      "title": "חיתוך וקידוח",
      "text": "חתוך את כל החלקים לפי תוכנית החיתוך. ברוחב הקרש של השלבים — שמור על אותו רווח כמו בקיר השולחן.",
      "add": []
    },
    {
      "title": "מסגרת הגג על העמודים",
      "text": "הברג את ארבע קורות הגג בין ארבעת העמודים, בקו אחד עם ראשי העמודים. בדוק אלכסונים.",
      "add": [
        "post",
        "topRailF",
        "topRailS"
      ]
    },
    {
      "title": "קורות הרצפה",
      "text": "הברג את שתי קורות הצד ואת הסף הקדמי בין העמודים, בגובה הרצפה. הגב נשאר פתוח לצנרת.",
      "add": [
        "sill"
      ]
    },
    {
      "title": "שלבי הצדדים",
      "text": "הברג את השלבים על הצד החיצוני של העמודים, מלמטה למעלה, עם שבלונה לרווח.",
      "add": [
        "sideSlat"
      ]
    },
    {
      "title": "הגג",
      "text": "הנח את קרשי הגג ברוחב הארון, עם הבליטה, והברג למסגרת.",
      "add": [
        "topBoard"
      ],
      "tip": "אם יש חשמל בפנים — זה הגג שמחזיק אותו יבש."
    },
    {
      "title": "מסגרת הדלת",
      "add": [
        "stile",
        "doorRail"
      ],
      "text": "לכל דלת: הנח את שני הניצבים (קרשי המסגרת האנכיים) על הרצפה, במרחק של רוחב הדלת זה מזה, והברג ביניהם את שתי הקורות הרוחביות — אחת למעלה ואחת למטה, בקצוות. בדוק אלכסונים שווים כדי שהמסגרת תהיה מלבנית.",
      "tip": "בנה את שתי הדלתות זו ליד זו על משטח ישר — כך הן יוצאות זהות."
    },
    {
      "title": "שלבי הדלת",
      "add": [
        "doorSlat"
      ],
      "text": "הנח את המסגרת שטוחה והברג עליה את השלבים הצרים לרוחב, מלמעלה למטה, עם המרווח שבתוכנית (השתמש בקרש דק כמרווח). השלבים מכסים את המסגרת — הברג כל שלב בשני ברגים לכל ניצב.",
      "tip": "התחל מהשלב העליון: הוא קובע את היישור של כל השאר."
    },
    {
      "title": "תליית הדלתות על הצירים",
      "text": "הברג את הצירים לדלת (על השלב, מול הניצב) — ציר עליון וציר תחתון. הרם את הדלת למקומה, שים מתחתיה קרש דק 6 מ\"מ כמרווח מהקורה התחתונה, והברג את הצירים לעמוד הארון. בדוק שהדלת נסגרת חופשי ושני הדלתות באותו גובה.",
      "add": [
        "hinge"
      ],
      "tip": "הצירים יושבים על השלב השני מלמטה ועל השלב השני מלמעלה — שם יש עץ מאחורי השלב (הניצב)."
    },
    {
      "title": "חיבור לשולחן",
      "text": "הצמד את הארון לשולחן כך שהעמוד האחורי־ימני שלו נוגע בעמוד האחורי של השולחן והעמוד הקדמי־ימני ברגל הקדמית. הברג דרך עמודי הארון אל עמודי השולחן (כוס Ø12 ואז בורג 5×100): 3 ברגים מאחור, 2 מלפנים. כך הארון לא יכול להתנדנד, והגג שלו מסתיים בדיוק על העמוד של השולחן.",
      "add": [
        "benchBackPost",
        "benchFrontLeg"
      ],
      "tip": "השולחן מצויר באפור — הוא כבר קיים, לא חותכים ולא קונים אותו."
    }
  ]
}